# Mailchimp Backup Tool - .gitignore

# Note: Backup files ARE committed to this PRIVATE repository
# mailchimp_backups/ - ALLOWED (contains actual backup data)
# *.zip - ALLOWED (contains actual backup data)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local

# API Keys - NEVER commit these
*.key
api_keys.txt
credentials.json

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
Thumbs.db
